# Google Sheets
SHEET_ID=paste_your_sheet_id_here
SHEET_TAB_NAME=Sheet1

# OAuth client (Desktop app type) from Google Cloud Console, authorized once
# via scripts/get-refresh-token.js — see README for the one-time setup.
GOOGLE_OAUTH_CLIENT_ID=paste_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=paste_client_secret_here
GOOGLE_OAUTH_REFRESH_TOKEN=paste_refresh_token_here

# Auth
JWT_SECRET=change_me_to_a_long_random_string

# Comma-separated reviewer credentials: name:password,name:password,...
REVIEWERS=Advait:changeme1,Judge2:changeme2,Judge3:changeme3,Judge4:changeme4,Judge5:changeme5

# Frontend origin allowed to call this API
FRONTEND_ORIGIN=http://localhost:5173

PORT=4000
